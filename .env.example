# Copia este fichero a ".env" (sin el ".example") y rellena los valores.
# El ".env" real NUNCA se sube a git (ya está en .gitignore) — aquí solo van ejemplos.

# Clave secreta de Django: la usa para firmar sesiones, cookies, etc. Genera una tuya con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" solo en tu portátil, en local. "False" (o sin poner la variable) en cualquier
# despliegue real: si se te olvida ponerla en un servidor, el valor por defecto es el seguro.
DJANGO_DEBUG=True

# Dominios/hosts desde los que se puede servir la app, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datos de conexión a PostgreSQL. En este portátil el servidor ya está instalado y arrancado
# (ver AGENTS.md); la base "kcalibra_dev" te la crea también el AGENTS.md.
DB_NAME=kcalibra_dev
DB_USER=euridicepretelrodriguez
# En este portátil la conexión local usa autenticación "trust" (sin contraseña real), pero la
# variable es igualmente obligatoria: pon cualquier valor no vacío. En un servidor de verdad,
# aquí sí iría la contraseña real.
DB_PASSWORD=sin_uso_en_local
DB_HOST=localhost
DB_PORT=5432
