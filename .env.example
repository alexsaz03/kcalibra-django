# Copia este fichero a ".env" (sin el ".example") y rellena los valores.
# El ".env" real NUNCA se sube a git (ya está en .gitignore) — aquí solo van ejemplos.

# Clave secreta de Django: la usa para firmar sesiones, cookies, etc. Genera una tuya con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" solo en tu portátil, en local. "False" (o sin poner la variable) en cualquier
# despliegue real: si se te olvida ponerla en un servidor, el valor por defecto es el seguro.
DJANGO_DEBUG=True

# Dominios/hosts desde los que se puede servir la app, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datos de conexión a PostgreSQL. En este portátil el servidor ya está instalado y arrancado
# (ver AGENTS.md); la base "kcalibra_dev" te la crea también el AGENTS.md.
DB_NAME=kcalibra_dev
# OJO: "euridicepretelrodriguez" es el usuario de ESTE portátil, no un valor fijo del
# proyecto. `createdb` (ver AGENTS.md) crea la base con el dueño de quien la ejecuta — en
# otra máquina, pon aquí el usuario del sistema de quien la haya creado allí (compruébalo con
# `whoami`).
DB_USER=euridicepretelrodriguez
# En este portátil la conexión local usa autenticación "trust" (sin contraseña real), pero la
# variable es igualmente obligatoria: pon cualquier valor no vacío. En un servidor de verdad,
# aquí sí iría la contraseña real.
DB_PASSWORD=sin_uso_en_local
DB_HOST=localhost
DB_PORT=5432

# R12: el registro de cuentas nuevas. "False" (o sin ponerla) es el valor seguro, y es el que
# toca en cualquier despliegue real mientras la app esté en internet sin más protección: nadie
# puede registrarse por su cuenta. Aquí, en ESTE fichero de ejemplo para tu portátil, va en
# "True" porque hace falta para poder recorrer el alta en local (ver AGENTS.md, sección 4): no
# hay contradicción, son dos sitios con dos necesidades distintas. En un .env de un servidor
# de verdad, empieza en "False" y se cambia a "True" el día del lanzamiento (G-31 del mapa).
DJANGO_REGISTRO_ABIERTO=True

# Por dónde salen los correos de verificación y los de recuperar contraseña (unidades 003 y
# 008). En este portátil, por la consola (no hace falta tocar nada más de este bloque: con
# este backend, las variables SMTP de abajo se cargan pero no se usan). En producción, SMTP de
# verdad — ADR-004 del meta-repo: Resend, con el dominio `kcalibra.app`. Cambiar de backend o
# de proveedor son estas variables, no código.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-responder@kcalibra.app

# SMTP real (ADR-004: Resend, `smtp.resend.com:587`, usuario literal "resend", contraseña = la
# API key de Resend). Vacío en local, porque con el backend de consola de arriba no se usa.
# En un despliegue real, rellena estos valores en el `.env` de ESE servidor — nunca aquí, y
# nunca en git (regla de oro: los secretos viven en `.private/`, jamás copiados al repo).
DJANGO_EMAIL_HOST=
# Si copias este fichero a un servidor y por error dejas PORT, TIMEOUT o USE_TLS en blanco (en
# vez de borrar la línea entera), la app arranca igual: cada una tiene su propio valor por
# defecto en `kcalibra/settings.py` (587, 10, cifrado activado) — nunca se queda sin arrancar
# ni, peor, sin cifrado en silencio (unidad 009). Si en vez de dejarla en blanco le pones un
# valor que no se entiende (un puerto que no es un número, o algo en USE_TLS que no es ni sí ni
# no), pasa lo contrario: la app se NIEGA a arrancar y el error te dice qué variable fue —
# nunca se queda a medias adivinando. USE_TLS no distingue mayúsculas ni espacios de más, y
# acepta las formas habituales: `true`, `1`, `yes`, `on`, `si`/`sí` activan el cifrado; `false`,
# `0`, `no`, `off` lo desactivan.
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
# Sin esto, un proveedor lento o caído cuelga la petición entera esperando en el socket, sin
# límite (la deuda que el ADR-004 dejó escrita). En blanco, usa el valor por defecto (ver la
# nota de arriba).
DJANGO_EMAIL_TIMEOUT=10
