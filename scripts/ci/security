#!/usr/bin/env bash
set -euo pipefail

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

# PYSEC-2026-3717 (CVE-2026-15830): DoS en GeoDjango (GEOSGeometry) al parsear WKT/WKB con
# recursión profunda. Esta app no usa GeoDjango ni ningún campo espacial (solo un JSONField
# vainilla), así que no es explotable aquí; el arreglo real es subir Django a 5.2.17/6.0.8 en
# requirements.txt, fuera de los ficheros de esta unidad. Se nombra y se acota, no se silencia
# el comando entero: cualquier otra vulnerabilidad sigue haciendo fallar el guion.
pip-audit -r requirements.txt --ignore-vuln PYSEC-2026-3717

# manage.py check --deploy exige HTTPS de verdad (SECURE_HSTS_SECONDS, SECURE_SSL_REDIRECT,
# SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE): eso lo aporta el proxy del despliegue, no esta
# unidad. Se nombran los cuatro avisos que hoy no se pueden cumplir; cualquier otro aviso o
# error hace fallar el guion entero, sin silenciar nada.
if SALIDA_DEPLOY="$(python manage.py check --deploy --fail-level WARNING 2>&1)"; then
    echo "$SALIDA_DEPLOY"
else
    echo "$SALIDA_DEPLOY"
    if ! SALIDA_DEPLOY="$SALIDA_DEPLOY" python3 <<'PY'
import os
import re
import sys

ESPERADOS = {"security.W004", "security.W008", "security.W012", "security.W016"}
texto = os.environ["SALIDA_DEPLOY"]
codigos = set(re.findall(r"\(([A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.[EWC]\d+)\)", texto))

# H2 de la 2ª revisión: mirar SOLO los códigos no basta. El `id` es OPCIONAL en Django
# (`core/checks/messages.py`: `id = "(%s) " % self.id if self.id else ""`), así que un aviso
# construido sin `id=` se imprime SIN paréntesis y el filtro no ve nada que restar: como los
# cuatro esperados siempre están, la resta salía vacía y el guion volvía a decir verde con
# Django diciendo rojo. Era H1 otra vez, por otra puerta.
#
# La cura no es un regex más listo: es CUADRAR EL RECUENTO. Django dice cuántos problemas ha
# encontrado; si ese número no coincide con los esperados que hemos reconocido, hay algo más
# ahí —lleve código o no— y el guion falla. Y si Django ni siquiera imprime ese recuento
# (`SystemCheckError` con traza), tampoco se da por bueno.
recuento = re.search(r"System check identified (\d+) issue", texto)
esperados_vistos = codigos & ESPERADOS
inesperados = codigos - ESPERADOS

todo_en_orden = (
    bool(esperados_vistos)
    and not inesperados
    and recuento is not None
    and int(recuento.group(1)) == len(esperados_vistos)
)
sys.exit(0 if todo_en_orden else 1)
PY
    then
        exit 1
    fi
fi
