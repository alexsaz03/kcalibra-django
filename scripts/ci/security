#!/usr/bin/env bash
set -euo pipefail

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

# Sin excepciones, a propósito. Hubo una —PYSEC-2026-3717, el DoS de GeoDjango que este mismo
# guion encontró el día que nació (unidad 039)— y duró lo que tardó en llegar su parche: la
# unidad 043 subió Django a 5.2.17 y la retiró. Un `--ignore-vuln` que ya no protege de nada es
# peor que no haberlo puesto nunca: se queda ahí, nadie lo relee, y el día de mañana silencia
# algo de verdad. Si vuelve a hacer falta otra, se nombra, se explica y se quita en cuanto haya
# arreglo — nunca se silencia el comando entero.
pip-audit -r requirements.txt

# Los cuatro avisos de HTTPS de verdad (SECURE_HSTS_SECONDS, SECURE_SSL_REDIRECT,
# SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE) los aporta el proxy del despliegue, no esta
# unidad: se toleran, nombrados uno a uno, en kcalibra/avisos_de_despliegue.py. Cualquier otro
# aviso, o error, hace fallar el guion entero, sin silenciar nada -- preguntando directamente
# al registro de checks de Django por sus objetos (unidad 045), no leyendo lo que imprime.
python -m kcalibra.avisos_de_despliegue
